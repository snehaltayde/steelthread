{
  "description": "steelthread: refuse to kill processes by name pattern or port sweep",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/no-pattern-kill.sh"
          }
        ]
      }
    ]
  }
}
